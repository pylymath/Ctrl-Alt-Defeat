# Practice / judging data must never be committed (practice pack README, "Rules for this data").
data/
archive*/
practice_pack/
*.wav
*.mp4
*.jpg
*.jpeg
*.png
*.pdf
# UI images you create yourselves go in assets/ and are allowed.
!assets/**

# Eval output contains reference answers copied from answers.json.
eval/results/

# Python / tooling
__pycache__/
*.pyc
.venv/
venv/
.env
neuroassist.env      # machine-specific settings written by the installer

# Model weights (GBs; GitHub rejects files over 100 MB). Share via Drive or Hugging Face instead.
models/
*.gguf
*.safetensors
*.bin
Modelfile
